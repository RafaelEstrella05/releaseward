    "deny": [
      "Bash(git reset*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl set*)",
      "Bash(kubectl annotate*)",
      "Bash(kubectl patch*)",
      "Bash(docker push*)",
      "Bash(rm -rf*)"
    ]
  }
}
